[user]
	# No identity set here on purpose — it comes from the includes at the
	# bottom of this file. See the comments there for how the two interact.
	#
	# Never fall back to guessing an identity from username@hostname. A guessed
	# address silently misattributes commits; this repo already carries four
	# different author addresses because of it. Fail loudly instead.
	useConfigOnly = true

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[fetch]
	prune = true

[diff]
    tool = kitty
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE

[alias]
	a = add .
	s = status
	c = commit -m
	ca = commit --amend 
	cae = commit --amend --no-edit
	cm = "!f() { \
    		git commit -m \"$1\" -m \"\" -m \"$2\"; \
	}; f"

	f = fetch
	r = rebase
	p = push
	pp = pull
	ch = checkout
	pfwl = push --force-with-lease
	pf = push --force
	pu = !git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)
	b = checkout -b
	bl = branch

	sync = "!f() { \
    		git fetch --prune && \
    		git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d 2>/dev/null; true; \
	}; f"

	sw = "!f() { \
        	if git show-ref --verify --quiet refs/heads/\"$1\"; then \
            		git checkout \"$1\"; \
        	else \
            		git fetch && git checkout \"$1\"; \
        	fi && git pull; \
    	}; f"
# This machine's default identity. Not tracked — create it per laptop with
# whatever that machine needs (work address, signing key, and so on).
[include]
	path = ~/.gitconfig.local

# Anything under ~/dotfiles always commits as the personal identity.
#
# This block is LAST on purpose. Git reads config top to bottom and the last
# value wins, so this overrides ~/.gitconfig.local no matter what that file
# sets. Put it above the include and a work address would leak into this
# public repo's history instead.
[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/config/git/personal
