# Dedicated alias for syncing this dotfiles repo.
#
# The remote is set to git@github-dotfiles:eshaan-mehta/dotfiles.git, so only
# this repo matches the block below and only this repo uses id_dotfiles.
# Everything else on the machine falls through to the ssh defaults untouched.
#
# id_dotfiles is a passphrase-less deploy key scoped to the dotfiles repo
# alone. Passphrase-less so the launchd auto-sync agent can push without a
# tty; scoped so it can't reach any other repo. No UseKeychain here — that
# keyword is macOS-only and fatal on Linux, and a passphrase-less key
# doesn't need it.

Host github-dotfiles
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_dotfiles
    IdentitiesOnly yes
