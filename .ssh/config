# Dedicated alias for syncing this dotfiles repo.
#
# The remote is set to git@github-dotfiles:eshaan-mehta/dotfiles.git, so only
# this repo matches the block below and only this repo uses id_dotfiles.
# Everything else on the machine falls through to the Host * block at the end.
#
# id_dotfiles is a passphrase-less deploy key scoped to the dotfiles repo
# alone. Passphrase-less so the launchd auto-sync agent can push without a
# tty; scoped so it can't reach any other repo.

Host github-dotfiles
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_dotfiles
    IdentitiesOnly yes

# Keep passphrase-protected keys unlocked across reboots: the passphrase is
# stored in the macOS Keychain on first use and keys are loaded into the agent
# automatically. UseKeychain is macOS-only and fatal on Linux, so IgnoreUnknown
# lets this file sync to Linux machines without breaking ssh there. Last in the
# file so the github-dotfiles block above matches first.

Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
